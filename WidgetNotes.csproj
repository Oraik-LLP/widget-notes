<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>WidgetNotes</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets\WidgetNotes.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained>
    <Version>1.4.0</Version>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed><DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tools\IconBuilder\**\*.cs" />
    <Resource Include="Assets\WidgetNotes.ico" />
  </ItemGroup>
</Project>

